# 사용자별 절대경로(~/Developer/video-use)로 가는 심볼릭 — 환경마다 새로 만들 것
.claude/skills/video-use

# 사용자가 고른 편집 갈래 (CLAUDE.md 첫 질문 결과) — 사람마다 다름
.edit-mode

# env / secrets
.env
.env.local
*.key

# raw / output 영상 (LFS 또는 클라우드로 별도 관리)
footage/*
!footage/.gitkeep

# video-use / motion-pipeline 중간 산출물
takes_packed.md
project.md
edit/
**/edit/
**/narration/
*.words.json

# hyperframes 빌드 산출물
hyperframes/out/
hyperframes/node_modules/
hyperframes/.cache/
hyperframes/.hyperframes/

# hyperframes의 외부 스킬 콘텐츠 (heygen-com/hyperframes 저작, Apache 2.0)
# 받는 사람 환경에서 setup.sh가 `npx skills add heygen-com/hyperframes`로 직접 받음
hyperframes/.agents/

# OS / editor
.DS_Store
*.log
node_modules/
__pycache__/
*.pyc
.venv/
hyperframes/renders/
/transcript.json
